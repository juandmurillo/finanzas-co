# Copia este archivo como .env (no se sube a GitHub) y completa solo lo que uses.
# Asistente opcional (pantalla «Asistente»): clave de https://console.anthropic.com
# ANTHROPIC_API_KEY=
# Otra ruta para la base de datos (por defecto data/finanzas.db)
# FINANZAS_DB_RUTA=
# Carpetas de respaldos y del agente (por defecto data/respaldos y data/agente)
# FINANZAS_BACKUPS_DIR=
# FINANZAS_AGENTE_DIR=
# Reglas propias de clasificación al importar (ver tests/fixtures/perfil_prueba.json)
# FINANZAS_PERFIL_CLASIFICACION=
# Semillas propias de cuentas y créditos (ver tests/fixtures/semillas_prueba.json)
# FINANZAS_SEMILLAS=
